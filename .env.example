# Copiar a /etc/manarem/api.env en el VPS y ajustar.
# Ninguna de estas variables va en Vercel: el frontend es estatico.

# Ruta del archivo SQLite. Fuera del repo, en un directorio que pueda escribir
# el usuario del servicio.
MANAREM_DB=/var/lib/manarem/manarem.db

# Origenes permitidos por CORS, separados por coma. Poner el dominio de Vercel.
# Si el frontend le pega a la API por el proxy /api de vercel.json, el pedido es
# del mismo origen y CORS ni se usa: igual conviene dejarlo puesto.
MANAREM_CORS_ORIGINS=https://manarem.vercel.app,http://localhost:8000

# 1 cuando hay nginx / Caddy / Cloudflare Tunnel adelante: hace que la IP del
# rate limit sea la del visitante y no la del proxy.
MANAREM_TRUST_PROXY=1

# Interfaz y puerto cuando se corre con `python app.py` (con gunicorn no aplica).
MANAREM_HOST=127.0.0.1
MANAREM_PORT=5000
MANAREM_DEBUG=0

# Sesiones
MANAREM_SESION_DIAS=7
MANAREM_SESIONES_POR_USUARIO=5
MANAREM_PASSWORD_MINIMO=8

# Tamaño maximo del cuerpo de un pedido, en bytes.
MANAREM_MAX_BODY=16384

# Cupos globales del sitio de prueba. -1 desactiva el cupo.
MANAREM_CUPO_USUARIOS=200
MANAREM_CUPO_TEMAS=500
MANAREM_CUPO_RESPUESTAS_TEMA=200
MANAREM_CUPO_OPINIONES=300
MANAREM_CUPO_OPINIONES_USUARIO=3
MANAREM_CUPO_MENSAJES=300

# Paginado del foro
MANAREM_TEMAS_POR_PAGINA=50
MANAREM_TEMAS_MAXIMO=100

# Metodo de hash de contraseñas. El default de Werkzeug (scrypt) reserva 32 MB
# de RAM por hash y en un VPS chico es un vector de carga: pbkdf2 usa memoria
# constante. Los hashes viejos siguen validando solos.
MANAREM_METODO_HASH=pbkdf2:sha256:200000

# Techo grueso de pedidos por IP, por encima de los limites de cada endpoint.
MANAREM_GLOBAL_MAXIMO=300
MANAREM_GLOBAL_VENTANA=60

# Cantidad maxima de opiniones que devuelve el listado.
MANAREM_OPINIONES_MAXIMO=100

# Cuantos proxies hay adelante. ProxyFix toma el valor N-esimo desde la derecha
# de X-Forwarded-For: si el numero es menor que la cadena real, la API ve la IP
# del proxy y el limite por IP se vuelve global. Cloudflare + Traefik = 2.
# Verificar con GET /salud/ip: el campo `ip` tiene que ser la del visitante.
MANAREM_PROXY_SALTOS=1
