[Unit]
Description=API de Manarem (Flask + gunicorn)
After=network.target

[Service]
User=manarem
Group=manarem
WorkingDirectory=/opt/manarem
EnvironmentFile=/etc/manarem/api.env
ExecStart=/opt/manarem/venv/bin/gunicorn \
    --workers 2 \
    --threads 4 \
    --bind 127.0.0.1:5000 \
    --access-logfile - \
    --error-logfile - \
    wsgi:app
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/manarem

[Install]
WantedBy=multi-user.target
